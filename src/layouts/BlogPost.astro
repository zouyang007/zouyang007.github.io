---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryDock from '../components/CategoryDock.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import UiCustomizer from '../components/UiCustomizer.astro';
import { libraryName } from '../utils/library';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-site-skin="cultivation" data-theme="dark">
	<head>
		<BaseHead
			title={`${title}`}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
	</head>
	<body>
		<Header />
		<CategoryDock />
		<UiCustomizer />
		<main>
			<article data-pagefind-body>
				<header class="article-head">
					<a class="category" href={`/categories/${encodeURIComponent(category)}/`}>{libraryName(category)} · {category}</a>
					<h1 data-pagefind-meta="title">{title}</h1>
					<p class="description">{description}</p>
					<div class="meta">
						<span>发布于 <FormattedDate date={pubDate} /></span>
						{updatedDate && <span>更新于 <FormattedDate date={updatedDate} /></span>}
					</div>
				</header>
				{heroImage && <Image class="hero-image" width={1120} height={620} src={heroImage} alt="" />}
				<div class="prose"><slot /></div>
				<footer class="article-footer">
					<p>归入此文的标签</p>
					<ul>{tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}</ul>
					<a class="back" href="/posts">← 返回全部文章</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { width: min(900px, calc(100% - 2rem)); padding-top: clamp(3.5rem, 8vw, 7rem); }
	.article-head { max-width: 760px; margin: 0 auto 3rem; text-align: center; }
	.category { display: inline-block; color: var(--accent); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-decoration: none; }
	h1 { margin: 0.8rem auto 1.2rem; font-size: clamp(2.4rem, 7vw, var(--ui-article-title-size)); letter-spacing: -0.04em; }
	.description { max-width: 620px; margin: 0 auto 1.3rem; color: var(--muted); font-size: 1.08rem; }
	.meta { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; color: var(--muted); font-size: 0.78rem; }
	.hero-image { display: block; width: 100%; margin: 0 auto 3rem; }
	.prose { max-width: var(--ui-reading-width); margin: 0 auto; font-family: var(--font-serif); font-size: 1.08rem; line-height: var(--ui-line-height); }
	.prose :global(h2), .prose :global(h3) { margin-top: 2.4em; scroll-margin-top: 6rem; }
	.prose :global(a) { text-underline-offset: 0.2em; }
	.prose :global(li) { margin: 0.45rem 0; }
	.article-footer { max-width: var(--ui-reading-width); margin: 4rem auto 0; padding-top: 2rem; border-top: 1px solid var(--line); }
	.article-footer p { margin-bottom: 0.65rem; color: var(--muted); font-size: 0.78rem; }
	.article-footer ul { display: flex; flex-wrap: wrap; gap: 0.65rem; margin: 0 0 2rem; padding: 0; list-style: none; }
	.article-footer li a { color: var(--muted); font-size: 0.82rem; }
	.back { color: var(--ink); font-size: 0.9rem; }
</style>
