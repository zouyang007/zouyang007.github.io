---
import { libraryName } from '../utils/library';
interface Item {
	name: string;
	count: number;
}

interface Props {
	items: Item[];
	basePath: '/categories' | '/tags';
}

const { items, basePath } = Astro.props;
---

<ul class="term-cloud">
	{items.map((item) => (
		<li>
			<a href={`${basePath}/${encodeURIComponent(item.name)}/`}>
				<span>{basePath === '/tags' ? `#${item.name}` : libraryName(item.name)}{basePath === '/categories' && <span class="original-category">{item.name}</span>}</span>
				<small>{item.count} 篇</small>
			</a>
		</li>
	))}
</ul>

<style>
	ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; margin: 0; padding: 0; list-style: none; }
	a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: max(var(--ui-radius), 4px); color: var(--ink); text-decoration: none; }
	a:hover { border-color: var(--accent); color: var(--accent); }
	small { color: var(--muted); white-space: nowrap; }
	@media (max-width: 620px) { ul { grid-template-columns: 1fr; } }
</style>
