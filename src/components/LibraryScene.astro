---
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const shelfSize = 8;
const shelves = Array.from({ length: Math.ceil(posts.length / shelfSize) }, (_, index) =>
	posts.slice(index * shelfSize, (index + 1) * shelfSize),
);
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});
const bookHues = [188, 216, 258, 304, 24, 154, 46, 278];
---

<section class="library-scene" data-library-scene aria-labelledby="library-title">
	<div class="scene-heading">
		<div>
			<p class="scene-code">ARCHIVE CHAMBER · {String(posts.length).padStart(2, '0')} VOLUMES</p>
			<h1 id="library-title">未来书房</h1>
		</div>
		<p>选择一本书，管家会把文章送到你面前。</p>
	</div>

	<div class="scene-floor" aria-hidden="true"></div>
	<div class="scene-layout">
		<section class="bookcase-zone" aria-label={`文章书架，共 ${posts.length} 本书`}>
			<div class="bookcase-crown">
				<span>MEMORY ARCHIVE</span>
				<span class="archive-light" aria-hidden="true"></span>
			</div>

			<div class="bookcase">
				{posts.length === 0 ? (
					<p class="empty-shelf">书架暂时是空的。</p>
				) : shelves.map((shelf, shelfIndex) => (
					<div class="shelf-row">
						<div class="books">
							{shelf.map((post, bookIndex) => {
								const absoluteIndex = shelfIndex * shelfSize + bookIndex;
								const title = post.data.title;
								const shortTitle = title.length > 14 ? `${title.slice(0, 14)}…` : title;
								const href = `/posts/${post.id}/`;
								const hue = bookHues[absoluteIndex % bookHues.length];
								const height = 76 + ((absoluteIndex * 13) % 25);
								const lean = ((absoluteIndex % 5) - 2) * 0.8;
								return (
									<a
										class="book"
										href={href}
										data-library-book
										data-title={title}
										data-description={post.data.description}
										data-category={post.data.category}
										data-keywords={post.data.tags.length ? post.data.tags.join(' · ') : '暂无关键词'}
										data-date={dateFormatter.format(post.data.pubDate)}
										data-href={href}
										aria-label={`取出文章：${title}`}
										aria-describedby="book-keyword-tooltip"
										style={`--book-hue:${hue};--book-height:${height}%;--book-lean:${lean}deg`}
									>
										<span class="book-top" aria-hidden="true"></span>
										<span class="book-spine">
											<span class="book-index">{String(absoluteIndex + 1).padStart(2, '0')}</span>
											<span class="book-title">{shortTitle}</span>
											<span class="book-pulse" aria-hidden="true"></span>
										</span>
										<span class="book-pages" aria-hidden="true"></span>
									</a>
								);
							})}
						</div>
						<div class="shelf-edge"><span>LEVEL {String(shelfIndex + 1).padStart(2, '0')}</span></div>
					</div>
				))}
			</div>
		</section>

		<aside class="butler-zone" aria-label="AI 阅读管家">
			<div class="butler-message" aria-live="polite">
				<p data-butler-status>AI BUTLER · ONLINE</p>
				<h2 data-butler-title>欢迎来到未来书房</h2>
				<p data-butler-message>书架上的每一本书都是一篇文章。请选一本，我来为你取阅。</p>
				<button type="button" class="skip-animation" data-skip-animation hidden>跳过动画</button>
			</div>

			<div class="butler-track">
				<div class="butler" data-library-butler>
					<div class="butler-halo" aria-hidden="true"></div>
					<div class="butler-avatar" role="img" aria-label="全息 AI 管家">🤖</div>
					<div class="held-book" data-held-book aria-hidden="true" hidden>
						<span data-held-title>档案</span>
					</div>
					<p>ARCHIVIST 07</p>
				</div>
			</div>
		</aside>
	</div>

	<div class="book-keyword-tooltip" id="book-keyword-tooltip" data-book-tooltip role="tooltip" hidden>
		<p data-tooltip-title>文章标题</p>
		<span data-tooltip-category>文章分类</span>
		<strong data-tooltip-keywords>关键词</strong>
	</div>

	<dialog class="book-presentation" data-book-presentation aria-labelledby="presented-title">
		<button type="button" class="dialog-close" data-close-presentation aria-label="关闭文章展示">×</button>
		<div class="presented-volume" aria-hidden="true">
			<div class="volume-spine"><span data-presented-index>01</span></div>
			<div class="volume-cover">
				<p data-presented-category>文章</p>
				<h2 data-presented-cover-title>文章标题</h2>
				<span data-presented-date></span>
			</div>
			<div class="volume-pages"></div>
		</div>
		<div class="presentation-copy">
			<p class="presentation-code">DELIVERED BY ARCHIVIST 07</p>
			<h2 id="presented-title" data-presented-title>文章标题</h2>
			<p data-presented-description></p>
			<div class="presentation-meta">
				<span data-presented-meta-category></span>
				<span data-presented-meta-date></span>
			</div>
			<a class="read-article" href="/posts" data-read-article>打开阅读</a>
		</div>
	</dialog>
</section>

<script>
	type SelectedBook = {
		title: string;
		description: string;
		category: string;
		date: string;
		href: string;
		index: string;
	};

	const scene = document.querySelector<HTMLElement>('[data-library-scene]');
	const butlerTitle = scene?.querySelector<HTMLElement>('[data-butler-title]');
	const butlerMessage = scene?.querySelector<HTMLElement>('[data-butler-message]');
	const butlerStatus = scene?.querySelector<HTMLElement>('[data-butler-status]');
	const skipButton = scene?.querySelector<HTMLButtonElement>('[data-skip-animation]');
	const heldBook = scene?.querySelector<HTMLElement>('[data-held-book]');
	const heldTitle = scene?.querySelector<HTMLElement>('[data-held-title]');
	const dialog = scene?.querySelector<HTMLDialogElement>('[data-book-presentation]');
	const tooltip = scene?.querySelector<HTMLElement>('[data-book-tooltip]');
	let activeBook: HTMLElement | null = null;
	let selectedBook: SelectedBook | null = null;
	let deliveryTimer = 0;
	let revealTimer = 0;
	let busy = false;

	function readBookData(book: HTMLElement): SelectedBook {
		return {
			title: book.dataset.title ?? '未命名文章',
			description: book.dataset.description ?? '',
			category: book.dataset.category ?? '文章',
			date: book.dataset.date ?? '',
			href: book.dataset.href ?? '/posts',
			index: book.querySelector<HTMLElement>('.book-index')?.textContent ?? '01',
		};
	}

	function positionTooltip(clientX: number, clientY: number) {
		if (!scene || !tooltip || tooltip.hidden) return;
		const sceneRect = scene.getBoundingClientRect();
		const tooltipRect = tooltip.getBoundingClientRect();
		const maxX = Math.max(12, sceneRect.width - tooltipRect.width - 12);
		const maxY = Math.max(12, sceneRect.height - tooltipRect.height - 12);
		const left = Math.min(Math.max(clientX - sceneRect.left + 16, 12), maxX);
		const top = Math.min(Math.max(clientY - sceneRect.top + 16, 12), maxY);
		tooltip.style.left = `${left}px`;
		tooltip.style.top = `${top}px`;
	}

	function showBookTooltip(book: HTMLElement, clientX?: number, clientY?: number) {
		if (!scene || !tooltip || busy) return;
		const setText = (selector: string, text: string) => {
			const target = tooltip.querySelector<HTMLElement>(selector);
			if (target) target.textContent = text;
		};
		setText('[data-tooltip-title]', book.dataset.title ?? '未命名文章');
		setText('[data-tooltip-category]', `分类 · ${book.dataset.category ?? '文章'}`);
		setText('[data-tooltip-keywords]', `关键词 · ${book.dataset.keywords ?? '暂无关键词'}`);
		tooltip.hidden = false;
		const bookRect = book.getBoundingClientRect();
		positionTooltip(clientX ?? bookRect.right, clientY ?? bookRect.top);
	}

	function hideBookTooltip() {
		if (tooltip) tooltip.hidden = true;
	}

	function populatePresentation(book: SelectedBook) {
		const setText = (selector: string, text: string) => {
			const target = scene?.querySelector<HTMLElement>(selector);
			if (target) target.textContent = text;
		};
		setText('[data-presented-index]', book.index);
		setText('[data-presented-category]', book.category);
		setText('[data-presented-cover-title]', book.title);
		setText('[data-presented-date]', book.date);
		setText('[data-presented-title]', book.title);
		setText('[data-presented-description]', book.description);
		setText('[data-presented-meta-category]', `分类 · ${book.category}`);
		setText('[data-presented-meta-date]', book.date);
		const readLink = scene?.querySelector<HTMLAnchorElement>('[data-read-article]');
		if (readLink) readLink.href = book.href;
		if (heldTitle) heldTitle.textContent = book.title.slice(0, 8);
	}

	function showPresentation() {
		window.clearTimeout(deliveryTimer);
		window.clearTimeout(revealTimer);
		if (!scene || !selectedBook) return;
		scene.classList.remove('is-fetching', 'is-returning');
		scene.removeAttribute('aria-busy');
		activeBook?.classList.remove('is-selected');
		if (heldBook) heldBook.hidden = true;
		if (skipButton) skipButton.hidden = true;
		if (butlerStatus) butlerStatus.textContent = 'AI BUTLER · DELIVERY COMPLETE';
		if (butlerTitle) butlerTitle.textContent = '这本书已经为你取来';
		if (butlerMessage) butlerMessage.textContent = '你可以先查看摘要，再决定是否打开全文。';
		busy = false;
		if (typeof dialog?.showModal === 'function') dialog.showModal();
		else dialog?.setAttribute('open', '');
	}

	function beginDelivery(bookElement: HTMLElement) {
		if (!scene || busy) return;
		busy = true;
		activeBook = bookElement;
		selectedBook = readBookData(bookElement);
		populatePresentation(selectedBook);
		const butler = scene.querySelector<HTMLElement>('[data-library-butler]');
		if (butler) {
			const bookRect = bookElement.getBoundingClientRect();
			const butlerRect = butler.getBoundingClientRect();
			const travelX = bookRect.right - butlerRect.left + 18;
			const travelY = bookRect.bottom - butlerRect.bottom;
			scene.style.setProperty('--butler-travel-x', `${travelX}px`);
			scene.style.setProperty('--butler-travel-y', `${travelY}px`);
		}
		scene.classList.add('is-fetching');
		scene.setAttribute('aria-busy', 'true');
		bookElement.classList.add('is-selected');
		if (skipButton) skipButton.hidden = false;
		if (butlerStatus) butlerStatus.textContent = 'AI BUTLER · RETRIEVING';
		if (butlerTitle) butlerTitle.textContent = `正在取阅第 ${selectedBook.index} 本书`;
		if (butlerMessage) butlerMessage.textContent = selectedBook.title;

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			showPresentation();
			return;
		}

		deliveryTimer = window.setTimeout(() => {
			scene.classList.add('is-returning');
			if (heldBook) heldBook.hidden = false;
			if (butlerStatus) butlerStatus.textContent = 'AI BUTLER · PRESENTING';
			if (butlerTitle) butlerTitle.textContent = '已找到，正在为你呈上';
		}, 1450);
		revealTimer = window.setTimeout(showPresentation, 3000);
	}

	for (const book of scene?.querySelectorAll<HTMLElement>('[data-library-book]') ?? []) {
		book.addEventListener('pointerenter', (event) => showBookTooltip(book, event.clientX, event.clientY));
		book.addEventListener('pointermove', (event) => positionTooltip(event.clientX, event.clientY));
		book.addEventListener('pointerleave', hideBookTooltip);
		book.addEventListener('focus', () => showBookTooltip(book));
		book.addEventListener('blur', hideBookTooltip);
	}

	scene?.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;
		const book = event.target.closest<HTMLElement>('[data-library-book]');
		if (!book || !scene.contains(book)) return;
		event.preventDefault();
		hideBookTooltip();
		beginDelivery(book);
	});

	skipButton?.addEventListener('click', showPresentation);
	scene?.querySelector('[data-close-presentation]')?.addEventListener('click', () => dialog?.close());
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});
</script>

<style>
	.library-scene {
		position: relative;
		width: 100%;
		min-height: calc(100vh - var(--ui-header-height) - 2rem);
		padding: clamp(1rem, 2.4vw, 2rem);
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
		border-radius: 24px;
		background:
			radial-gradient(circle at 78% 24%, rgba(111, 123, 255, 0.19), transparent 27rem),
			linear-gradient(145deg, rgba(4, 15, 32, 0.9), rgba(2, 7, 18, 0.96));
		box-shadow: 0 34px 100px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
		isolation: isolate;
		perspective: 1500px;
	}

	.library-scene::before {
		position: absolute;
		z-index: -2;
		inset: 0;
		content: '';
		pointer-events: none;
		background:
			linear-gradient(rgba(92, 225, 255, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(92, 225, 255, 0.035) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: linear-gradient(to bottom, black, transparent 82%);
	}

	.scene-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: clamp(1.2rem, 2.6vw, 2.2rem);
	}

	.scene-heading h1 { margin: 0.15rem 0 0; font-size: clamp(2.2rem, 5vw, 4.6rem); letter-spacing: -0.055em; }
	.scene-heading > p { max-width: 25rem; margin: 0 0 0.4rem; color: var(--muted); text-align: right; }
	.scene-code { margin: 0; color: var(--accent); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.72rem; letter-spacing: 0.16em; }

	.scene-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 0.72fr);
		gap: clamp(1.2rem, 3vw, 3rem);
		align-items: stretch;
		transform-style: preserve-3d;
	}

	.scene-floor {
		position: absolute;
		z-index: -1;
		right: -18%;
		bottom: -36%;
		left: -18%;
		height: 58%;
		background:
			linear-gradient(rgba(92, 225, 255, 0.14) 1px, transparent 1px),
			linear-gradient(90deg, rgba(92, 225, 255, 0.14) 1px, transparent 1px);
		background-size: 64px 34px;
		box-shadow: inset 0 20px 70px rgba(92, 225, 255, 0.06);
		pointer-events: none;
		transform: rotateX(68deg);
		transform-origin: top;
	}

	.bookcase-zone {
		position: relative;
		z-index: 6;
		padding: 0.8rem;
		border: 1px solid rgba(92, 225, 255, 0.28);
		border-radius: 16px;
		background: linear-gradient(145deg, rgba(10, 32, 57, 0.78), rgba(3, 11, 25, 0.94));
		box-shadow: 18px 28px 60px rgba(0, 0, 0, 0.32), inset 10px 0 24px rgba(92, 225, 255, 0.035), inset -2px -2px 0 rgba(0, 0, 0, 0.5);
		transform: rotateY(3deg) translateZ(14px);
		transform-origin: left center;
	}

	.bookcase-crown {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 2.5rem;
		padding: 0 0.85rem;
		border: 1px solid rgba(92, 225, 255, 0.2);
		border-radius: 8px 8px 2px 2px;
		background: linear-gradient(180deg, rgba(14, 48, 78, 0.94), rgba(6, 20, 38, 0.94));
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.11), 0 8px 18px rgba(0, 0, 0, 0.28);
		color: var(--muted);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.15em;
	}

	.bookcase-crown, .archive-light { pointer-events: none; }
	.archive-light { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 14px var(--accent); }
	.bookcase { position: relative; z-index: 3; max-height: min(62vh, 44rem); padding: 0.7rem 0.25rem 0.15rem; overflow-x: visible; overflow-y: auto; scrollbar-color: rgba(92, 225, 255, 0.35) transparent; }
	.shelf-row { position: relative; z-index: 1; min-height: 9.4rem; padding: 0.8rem 0.7rem 1.05rem; isolation: isolate; border-right: 0.65rem solid #06172a; border-left: 0.65rem solid #06172a; background: linear-gradient(90deg, rgba(0, 0, 0, 0.22), transparent 14%, transparent 86%, rgba(0, 0, 0, 0.26)); }
	.books { position: relative; z-index: 4; display: flex; height: 7rem; align-items: end; justify-content: center; gap: clamp(0.28rem, 0.75vw, 0.64rem); perspective: 900px; pointer-events: auto; }

	.book {
		position: relative;
		z-index: 2;
		display: block;
		width: clamp(2rem, 4.6vw, 3.45rem);
		height: var(--book-height);
		min-height: 5.2rem;
		color: hsl(var(--book-hue) 95% 88%);
		pointer-events: auto;
		touch-action: manipulation;
		text-decoration: none;
		transform: rotateZ(var(--book-lean)) rotateY(-8deg) translateZ(0);
		transform-origin: center bottom;
		transform-style: preserve-3d;
		transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), filter 260ms ease, opacity 260ms ease;
	}

	.book-spine {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-rows: auto 1fr auto;
		justify-items: center;
		gap: 0.25rem;
		padding: 0.35rem 0.22rem;
		border: 1px solid hsla(var(--book-hue) 90% 72% / 0.62);
		border-radius: 4px 2px 2px 4px;
		background: linear-gradient(90deg, hsl(var(--book-hue) 58% 19%), hsl(var(--book-hue) 70% 34%) 44%, hsl(var(--book-hue) 56% 15%));
		box-shadow: inset 3px 0 5px rgba(255, 255, 255, 0.12), inset -4px 0 7px rgba(0, 0, 0, 0.34), 5px 8px 12px rgba(0, 0, 0, 0.34);
		backface-visibility: hidden;
	}

	.book-top { position: absolute; z-index: -1; top: -5px; right: -7px; left: 3px; height: 9px; border: 1px solid hsla(var(--book-hue) 80% 72% / 0.42); background: hsl(var(--book-hue) 44% 30%); pointer-events: none; transform: rotateX(62deg); transform-origin: bottom; }
	.book-pages { position: absolute; z-index: -2; top: 4px; right: -8px; bottom: 3px; width: 11px; background: repeating-linear-gradient(0deg, #dceff3 0 1px, #76929a 2px 3px); pointer-events: none; transform: rotateY(76deg); transform-origin: left; }
	.book-index { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.48rem; letter-spacing: 0.08em; }
	.book-title { overflow: hidden; font-size: clamp(0.58rem, 0.85vw, 0.72rem); font-weight: 700; line-height: 1.15; text-align: center; writing-mode: vertical-rl; }
	.book-pulse { width: 0.3rem; height: 0.3rem; border-radius: 50%; background: currentColor; box-shadow: 0 0 8px currentColor; pointer-events: none; }
	.book:hover, .book:focus-visible { z-index: 4; filter: brightness(1.35); transform: translateY(-12px) rotateZ(0deg) rotateY(-22deg) translateZ(28px); }
	.book.is-selected { z-index: 5; animation: book-picked 3s ease both; }

	.shelf-edge {
		position: absolute;
		right: -0.75rem;
		bottom: 0;
		left: -0.75rem;
		height: 1.15rem;
		border: 1px solid rgba(92, 225, 255, 0.18);
		background: linear-gradient(180deg, #102c46, #04101f 58%, #020711);
		box-shadow: 0 8px 12px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.12);
		pointer-events: none;
		transform: rotateX(-18deg);
		transform-origin: top;
	}
	.shelf-edge span { position: absolute; right: 0.55rem; top: 0.05rem; color: rgba(134, 169, 186, 0.7); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.45rem; letter-spacing: 0.12em; }

	.butler-zone { position: relative; z-index: 2; display: grid; min-height: 34rem; grid-template-rows: auto 1fr; align-items: end; pointer-events: none; }
	.butler-message { position: relative; z-index: 5; padding: 1rem; border: 1px solid rgba(92, 225, 255, 0.32); border-radius: 12px; background: rgba(6, 23, 42, 0.82); box-shadow: 0 16px 42px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.1); backdrop-filter: blur(16px); }
	.butler-message::after { position: absolute; right: 2.4rem; bottom: -0.55rem; width: 1rem; height: 1rem; border-right: 1px solid rgba(92, 225, 255, 0.32); border-bottom: 1px solid rgba(92, 225, 255, 0.32); content: ''; background: rgba(6, 23, 42, 0.9); transform: rotate(45deg); }
	.butler-message > p:first-child { margin: 0 0 0.45rem; color: var(--accent); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.62rem; letter-spacing: 0.12em; }
	.butler-message h2 { margin: 0; font-size: clamp(1.25rem, 2.2vw, 1.8rem); }
	.butler-message > p:not(:first-child) { margin: 0.55rem 0 0; color: var(--muted); font-size: 0.86rem; line-height: 1.6; }
	.skip-animation { position: relative; z-index: 1; margin-top: 0.75rem; padding: 0.38rem 0.7rem; border: 1px solid rgba(92, 225, 255, 0.38); border-radius: 999px; background: transparent; color: var(--accent); cursor: pointer; font-size: 0.7rem; pointer-events: auto; }

