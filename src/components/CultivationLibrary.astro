---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
const names: Record<string, {name: string; note: string; tone: string}> = {
 '历史上的今天': { name: '大陆纪要', note: '朝代兴替，岁月留痕', tone: 'ochre' },
 '每日新闻早报': { name: '万界见闻', note: '四海风物，人间新事', tone: 'jade' },
 'AI新闻速递': { name: '天机秘录', note: '推演万象，窥见未来', tone: 'indigo' },
 'GitHub高分项目': { name: '百工造物', note: '奇巧之术，开源之器', tone: 'red' },
};
const categories = [...new Set(posts.map(post => post.data.category))];
const ordered = [...Object.keys(names).filter(category => categories.includes(category)), ...categories.filter(category => !names[category])];
const shelves = ordered.map((category, index) => ({
 category, id: `collection-${index + 1}`, ...(names[category] ?? {name: `${category}阁`, note: '拾遗录事，收纳新知', tone: 'ochre'}),
 posts: posts.filter(post => post.data.category === category),
}));
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {year:'numeric',month:'2-digit',day:'2-digit'}).format(date);
---

<div class="cultivation-library" data-cultivation-library>
 <section class="pavilion" data-pavilion aria-labelledby="pavilion-title">
  <img class="pavilion-art" src="/images/immortal-library.webp" width="1536" height="1024" alt="云山之间的三层藏书阁，飞檐下灯火温暖，中央石阶通向木制大门" fetchpriority="high" />
  <div class="pavilion-shade" aria-hidden="true"></div>
  <div class="pavilion-heading"><p>未名手记 · 山中一阁</p><h1 id="pavilion-title">藏书阁</h1><span>收天下见闻 · 藏万卷新知</span></div>
  <a class="pavilion-door" href="#shelves" data-enter-library aria-label="推门入阁，浏览分类书架"><span>推门入阁</span><small>叩门 · 阅卷</small></a>
  <div class="pavilion-caption"><span>{shelves.length} 座书架 · {posts.length} 卷藏书</span><p>择一卷书，入一方天地。</p><a href="/posts/">直接浏览全部文章 →</a></div>
 </section>

 <section class="library-interior" id="shelves" data-library-interior aria-labelledby="interior-title">
  <header class="interior-heading"><div><p class="eyebrow">云深处 · 藏书阁</p><h2 id="interior-title" tabindex="-1">万卷入阁</h2><p>依门类寻书，轻触书脊即可展卷。</p></div><a href="#" data-leave-library class="quiet-button">返回阁前</a></header>
  <nav class="collection-nav" aria-label="藏书分类">{shelves.map(shelf => <a href={`#${shelf.id}`}><span>{shelf.name}</span><small>{shelf.posts.length} 卷</small></a>)}</nav>
  <div class="shelf-gallery">{shelves.map((shelf, shelfIndex) => (
   <section class:list={['archive-cabinet', shelf.tone]} id={shelf.id} aria-labelledby={`${shelf.id}-title`} data-category-shelf data-category={shelf.category} style={`--shelf-order:${shelfIndex}`}>
    <header class="cabinet-heading"><span class="cabinet-number">{['壹','贰','叁','肆'][shelfIndex] ?? String(shelfIndex + 1)}</span><div><h3 id={`${shelf.id}-title`}>{shelf.name}</h3><p>{shelf.category} · {shelf.note}</p></div><span class="volume-count">{shelf.posts.length} 卷</span></header>
    <div class="shelf-books">{shelf.posts.map((post, index) => (
     <div class="book-slot">
      <a class="ancient-book" href={`/posts/${post.id}/`} data-library-book data-title={post.data.title} data-description={post.data.description} data-category={post.data.category} data-collection={shelf.name} data-keywords={post.data.tags.join(' · ') || post.data.category} data-date={formatDate(post.data.pubDate)} aria-label={`展卷：${post.data.title}`} aria-describedby="book-keyword-tooltip" style={`--volume-height:${146 + (index % 4) * 8}px;--lean:${(index % 3 - 1) * 1.5}deg;--book-order:${index}`}>
       <span class="volume-visual"><span class="thread-binding" aria-hidden="true">┄<br/>┄<br/>┄</span><span class="volume-label">{post.data.title.slice(0, 16)}{post.data.title.length > 16 ? '…' : ''}</span><span class="volume-index">{String(index + 1).padStart(2, '0')}</span></span>
      </a>
     </div>
    ))}</div>
    <footer class="cabinet-footer"><span>{shelf.name} · 藏</span><a href={`/categories/${encodeURIComponent(shelf.category)}/`}>查看本门全部文章 →</a></footer>
   </section>
  ))}</div>
 {posts.length === 0 && <p class="empty-library">阁中暂未收录典籍，待来日添卷。</p>}
 </section>

 <div class="entry-transition" data-entry-transition aria-hidden="true" hidden>
  <div class="spirit-light" aria-hidden="true"></div>
  <div class="spirit-tunnel" aria-hidden="true">{Array.from({length: 8}, (_, index) => <i style={`--ray:${index}`}></i>)}</div>
  <div class="transition-gate" aria-hidden="true">
   <div class="gate-panel gate-panel-left"><span></span><i></i></div>
   <div class="gate-panel gate-panel-right"><span></span><i></i></div>
  </div>
  <div class="cloud-veil" aria-hidden="true">{Array.from({length: 7}, (_, index) => <i style={`--cloud:${index}`}></i>)}</div>
  <div class="entry-inscription"><span data-entry-stage>门扉应声而启</span><small>ENTERING THE ARCHIVE</small><b aria-hidden="true"></b></div>
 </div>
 <p class="sr-only" aria-live="polite" data-entry-announcer></p>

 <div class="keyword-tooltip" id="book-keyword-tooltip" data-book-tooltip role="tooltip" hidden><strong data-tooltip-title></strong><span data-tooltip-category></span><p data-tooltip-keywords></p></div>
 <dialog class="scroll-dialog" data-book-presentation aria-labelledby="scroll-title">
  <button type="button" data-close-presentation class="close-scroll" aria-label="合上书卷">×</button>
  <p class="eyebrow" data-presented-collection></p><span class="scroll-seal" aria-hidden="true">藏</span>
  <h2 id="scroll-title" data-presented-title></h2>
  <p class="scroll-meta"><span data-presented-category></span><span data-presented-date></span></p>
  <div class="scroll-rule" aria-hidden="true"></div><p class="scroll-description" data-presented-description></p>
  <a class="read-scroll" data-read-article href="/posts/">展开全文 <span aria-hidden="true">→</span></a>
 </dialog>
</div>

<script>
 const root = document.querySelector<HTMLElement>('[data-cultivation-library]');
 if (root) {
  const pavilion = root.querySelector<HTMLElement>('[data-pavilion]')!;
  const interior = root.querySelector<HTMLElement>('[data-library-interior]')!;
  const entrance = root.querySelector<HTMLAnchorElement>('[data-enter-library]')!;
  const transition = root.querySelector<HTMLElement>('[data-entry-transition]')!;
  const stageText = transition.querySelector<HTMLElement>('[data-entry-stage]')!;
  const announcer = root.querySelector<HTMLElement>('[data-entry-announcer]')!;
  const dialog = root.querySelector<HTMLDialogElement>('[data-book-presentation]')!;
  const tooltip = root.querySelector<HTMLElement>('[data-book-tooltip]')!;
  let opening = false;
  let transitionTimers: number[] = [];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const schedule = (callback: () => void, delay: number) => {
   transitionTimers.push(window.setTimeout(callback, delay));
  };
  const clearTransitionTimers = () => {
   transitionTimers.forEach(window.clearTimeout);
   transitionTimers = [];
  };
  const syncRoom = () => {
   const inside = location.hash === '#shelves' || location.hash.startsWith('#collection-');
   pavilion.hidden = inside; interior.hidden = !inside;
  };
  syncRoom();
  window.addEventListener('hashchange', syncRoom);
  entrance.addEventListener('click', (event) => {
   event.preventDefault();
   if (opening) return;
   opening = true;
   clearTransitionTimers();
   entrance.setAttribute('aria-disabled', 'true');
   document.documentElement.dataset.libraryTransition = 'active';
   pavilion.classList.add('is-opening');
   transition.hidden = false;
   stageText.textContent = '门扉应声而启';
   announcer.textContent = '藏书阁门扉正在开启';
   requestAnimationFrame(() => transition.classList.add('is-active'));

   const swapDelay = reducedMotion ? 0 : 1500;
   const finishDelay = reducedMotion ? 120 : 2800;
   schedule(() => { stageText.textContent = '穿云入阁'; }, reducedMotion ? 0 : 820);
   schedule(() => {
    location.hash = 'shelves'; syncRoom();
    window.scrollTo({top:0,behavior:'instant'});
    stageText.textContent = '万卷在前';
    announcer.textContent = '已穿过门扉，正在进入藏书阁';
   }, swapDelay);
   schedule(() => {
    transition.classList.remove('is-active');
    transition.hidden = true;
    pavilion.classList.remove('is-opening');
    interior.classList.add('is-arriving');
    document.documentElement.removeAttribute('data-library-transition');
    entrance.removeAttribute('aria-disabled');
    interior.querySelector<HTMLElement>('h2')?.focus({preventScroll:true});
    announcer.textContent = '已进入藏书阁，可以依分类选择文章';
    opening = false;
    schedule(() => interior.classList.remove('is-arriving'), reducedMotion ? 0 : 1800);
   }, finishDelay);
  });
  root.querySelector('[data-leave-library]')?.addEventListener('click', () => {
   tooltip.hidden = true;
   interior.classList.remove('is-arriving');
   window.setTimeout(() => { entrance.focus({preventScroll:true}); window.scrollTo({top:0,behavior:'instant'}); }, 0);
  });
  const positionTooltip = (x: number, y: number) => {
   const bounds = tooltip.getBoundingClientRect();
   tooltip.style.left = `${Math.max(10, Math.min(x + 14, innerWidth - bounds.width - 10))}px`;
   tooltip.style.top = `${Math.max(10, Math.min(y + 18, innerHeight - bounds.height - 10))}px`;
  };
  for (const book of root.querySelectorAll<HTMLAnchorElement>('[data-library-book]')) {
   const show = (x?: number, y?: number) => {
    tooltip.querySelector('[data-tooltip-title]')!.textContent = book.dataset.title ?? '';
    tooltip.querySelector('[data-tooltip-category]')!.textContent = `${book.dataset.collection} · ${book.dataset.category}`;
    tooltip.querySelector('[data-tooltip-keywords]')!.textContent = `关键词 · ${book.dataset.keywords}`;
    tooltip.hidden = false; const box = book.getBoundingClientRect(); positionTooltip(x ?? box.right, y ?? box.top);
   };
   book.addEventListener('pointerenter', e => {if (e.pointerType !== 'touch') show(e.clientX, e.clientY);});
   book.addEventListener('pointermove', e => { if (e.pointerType !== 'touch' && !dialog.open) show(e.clientX, e.clientY); });
   book.addEventListener('pointerleave', () => tooltip.hidden = true);
   book.addEventListener('focus', () => show());
   book.addEventListener('blur', () => tooltip.hidden = true);
   book.addEventListener('click', e => {
    if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
    e.preventDefault(); tooltip.hidden = true;
    for (const field of ['title','description','category','date','collection']) {
     dialog.querySelector(`[data-presented-${field}]`)!.textContent = book.dataset[field] ?? '';
    }
    dialog.querySelector<HTMLAnchorElement>('[data-read-article]')!.href = book.href;
    dialog.showModal();
   });
  }
  root.querySelector('[data-close-presentation]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', e => { if(e.target === dialog) { const r=dialog.getBoundingClientRect(); if(e.clientX<r.left || e.clientX>r.right || e.clientY<r.top || e.clientY>r.bottom) dialog.close(); } });
  dialog.addEventListener('close', () => tooltip.hidden = true);
  window.addEventListener('scroll', () => tooltip.hidden = true, {passive:true});
  window.addEventListener('resize', () => tooltip.hidden = true);
  window.addEventListener('pagehide', () => {
   clearTransitionTimers();
   document.documentElement.removeAttribute('data-library-transition');
  });
 }
</script>

<style>
 .cultivation-library { --gold:#d7b780; --jade:#91a995; --text:#efe7d5; color:var(--text); font-family:var(--font-serif); }
 [hidden] { display:none !important; }
 .pavilion { position:relative; height:calc(100svh - var(--ui-header-height)); min-height:650px; overflow:hidden; background:#142320; --image-height:max(66.6667vw, calc(100svh - var(--ui-header-height)), 650px); }
 .pavilion-art { width:100%; height:100%; object-fit:cover; object-position:center; border-radius:0; transition:transform 1700ms cubic-bezier(.2,.7,.2,1),filter 1500ms ease; }
 .pavilion-shade { position:absolute; inset:0; pointer-events:none; background:linear-gradient(180deg,rgba(6,17,17,.52),transparent 28%,transparent 68%,rgba(5,15,14,.92)); }
 .pavilion-heading { position:absolute; top:3%; left:50%; transform:translateX(-50%); text-align:center; width:90%; text-shadow:0 3px 18px #071512; pointer-events:none; }
 .pavilion-heading p { margin:0 0 .4rem; font-size:.85rem; letter-spacing:.38em; color:#e7d6b5; }
 .pavilion-heading h1 { margin:0; font-size:clamp(2.6rem,5.5vw,4.8rem); letter-spacing:.3em; padding-left:.3em; font-weight:500; color:#f4e8ce; }
 .pavilion-heading > span { display:block; margin-top:.7rem; color:#d2d8cc; font-size:.85rem; letter-spacing:.2em; }
 .pavilion-door { position:absolute; left:50%; top:calc(50% + var(--image-height) * .129); transform:translate(-50%,-50%); width:calc(var(--image-height) * .15); min-width:110px; height:calc(var(--image-height) * .15); min-height:100px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.4rem; border:1px solid rgba(231,189,107,.45); border-radius:3px; color:#ffedc1; text-decoration:none; background:rgba(26,16,5,.12); box-shadow:inset 0 0 20px #efb55228,0 0 24px #e8c77322; transition:background .25s,box-shadow .25s,opacity .28s ease .38s; }
 .pavilion-door span { padding:.5rem .65rem; background:#1e160dbb; border:1px solid #b8955d80; letter-spacing:.18em; font-size:1rem; }
 .pavilion-door small { font-size:.75rem; text-shadow:0 2px 5px #000; }
 .pavilion-door:hover,.pavilion-door:focus-visible { color:#fff2ce; background:#f2bd5530; box-shadow:inset 0 0 35px #f3c36d55,0 0 42px #e6b64e55; outline:2px solid var(--gold); outline-offset:5px; }
 .is-opening .pavilion-art { transform:scale(1.24); transform-origin:50% 63%; filter:brightness(1.42) saturate(1.12); }
 .is-opening .pavilion-door { opacity:0; pointer-events:none; animation:door-knock 420ms ease both; }
 .is-opening .pavilion-heading,.is-opening .pavilion-caption { opacity:0; transition:opacity 450ms ease; }
 .pavilion-caption { position:absolute; left:0; right:0; bottom:3%; text-align:center; }
 .pavilion-caption > span { color:#b9c8bb; font-size:.85rem; letter-spacing:.18em; }
 .pavilion-caption p { margin:.45rem 0; color:#f1e0bf; font-size:1.1rem; letter-spacing:.1em; }
 .pavilion-caption a { color:#bac5b7; font-size:.85rem; text-underline-offset:5px; }
 :global(html[data-library-transition='active']) { overflow:hidden; }
 .entry-transition { position:fixed; z-index:120; inset:var(--ui-header-height) 0 0; overflow:hidden; perspective:1200px; background:radial-gradient(circle at 50% 50%,#d9bd78 0,#355143 22%,#101d18 62%,#050b09 100%); opacity:0; pointer-events:auto; }
 .entry-transition.is-active { animation:entry-curtain 2800ms linear both; }
 .transition-gate { position:absolute; z-index:2; inset:-5%; display:flex; transform-style:preserve-3d; animation:gate-approach 1900ms cubic-bezier(.18,.74,.2,1) both; }
 .gate-panel { position:relative; width:50%; height:100%; overflow:hidden; backface-visibility:hidden; background:linear-gradient(90deg,#1a1009,#56391f 18%,#342114 74%,#120b07); border:clamp(5px,1vw,14px) solid #171009; box-shadow:inset 0 0 0 2px #b58a4f55,inset 0 0 60px #000c,0 0 45px #000b; }
 .gate-panel::before,.gate-panel::after { content:''; position:absolute; left:8%; right:8%; height:2px; background:#b591596b; box-shadow:0 0 10px #d6b36d40; }
 .gate-panel::before { top:30%; }
 .gate-panel::after { bottom:30%; }
 .gate-panel > span { position:absolute; inset:7%; border:1px solid #9c794c55; box-shadow:inset 0 0 35px #000b; }
 .gate-panel > i { position:absolute; top:50%; width:clamp(22px,3vw,42px); aspect-ratio:1; border:clamp(3px,.5vw,7px) solid #bb965c; border-radius:50%; box-shadow:0 0 14px #e9c46c55,inset 0 0 10px #0008; }
 .gate-panel-left { transform-origin:left center; animation:gate-open-left 1450ms cubic-bezier(.42,0,.18,1) 280ms both; }
 .gate-panel-right { transform-origin:right center; animation:gate-open-right 1450ms cubic-bezier(.42,0,.18,1) 280ms both; }
 .gate-panel-left > i { right:7%; }
 .gate-panel-right > i { left:7%; }
 .spirit-light { position:absolute; z-index:0; left:50%; top:50%; width:18vmin; aspect-ratio:1; border-radius:50%; background:#fff8d8; box-shadow:0 0 10vmin 4vmin #ffe6a8,0 0 35vmin 18vmin #aec9a9; transform:translate(-50%,-50%); animation:spirit-bloom 2300ms cubic-bezier(.2,.7,.2,1) 380ms both; }
 .spirit-tunnel { position:absolute; z-index:1; inset:0; overflow:hidden; opacity:0; animation:tunnel-reveal 1350ms ease 700ms both; }
 .spirit-tunnel i { position:absolute; left:50%; top:50%; width:2px; height:86vmax; background:linear-gradient(#fffbd900,#fffbd9cc 45%,#fffbd900); transform-origin:50% 0; transform:rotate(calc(var(--ray) * 45deg)) translateY(-50%); animation:ray-flight 650ms ease-in-out calc(760ms + var(--ray) * 45ms) both; }
 .cloud-veil { position:absolute; z-index:3; inset:0; overflow:hidden; pointer-events:none; }
 .cloud-veil i { position:absolute; left:calc((var(--cloud) - 1) * 17%); top:calc(10% + var(--cloud) * 9%); width:48vw; height:24vh; border-radius:50%; background:radial-gradient(ellipse,#e8eee0d9 0,#c9d6c5a8 38%,#9eb1a000 72%); filter:blur(16px); opacity:0; animation:cloud-cross 1150ms ease-out calc(1050ms + var(--cloud) * 80ms) both; }
 .entry-inscription { position:absolute; z-index:5; left:50%; bottom:10%; width:min(420px,80vw); transform:translateX(-50%); text-align:center; text-shadow:0 2px 14px #06100c; animation:inscription-arrive 2100ms ease 260ms both; }
 .entry-inscription span { display:block; color:#fff1c8; font-family:var(--font-serif); font-size:clamp(1.25rem,3vw,2rem); letter-spacing:.35em; padding-left:.35em; }
 .entry-inscription small { display:block; margin-top:.7rem; color:#cbd8ca; font-size:.65rem; letter-spacing:.32em; }
 .entry-inscription b { display:block; width:min(260px,60vw); height:1px; margin:1.15rem auto 0; overflow:hidden; background:#cfb27140; }
 .entry-inscription b::after { content:''; display:block; width:100%; height:100%; background:#f0d18d; transform-origin:left; animation:entry-progress 2450ms cubic-bezier(.2,.65,.2,1) 250ms both; }
 .library-interior { min-height:80vh; max-width:1400px; margin:auto; padding:3rem 2rem 5rem; }
 .library-interior.is-arriving .interior-heading { animation:interior-rise 680ms cubic-bezier(.18,.76,.2,1) both; }
 .library-interior.is-arriving .collection-nav { animation:interior-rise 720ms cubic-bezier(.18,.76,.2,1) 100ms both; }
 .library-interior.is-arriving .archive-cabinet { animation:cabinet-arrive 820ms cubic-bezier(.18,.76,.2,1) calc(220ms + var(--shelf-order) * 130ms) both; }
 .library-interior.is-arriving .volume-visual { animation:volume-settle 580ms cubic-bezier(.2,.75,.2,1) calc(430ms + var(--book-order) * 28ms) both; }
 .interior-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:2rem; }
 .eyebrow { margin:0 0 .65rem; color:var(--gold); font-size:.85rem; letter-spacing:.25em; }
 .interior-heading h2 { margin:0 0 .75rem; font-size:clamp(2.3rem,5vw,3.8rem); color:var(--text); font-weight:500; letter-spacing:.15em; }
 .interior-heading div > p:last-child { color:#a6b4a8; margin:0; font-size:1rem; }
 .quiet-button { padding:.6rem 1rem; border:1px solid #a98d584d; color:#d5bd90; text-decoration:none; white-space:nowrap; font-size:.9rem; }
 .collection-nav { display:flex; flex-wrap:wrap; border-top:1px solid #a98d5840; border-bottom:1px solid #a98d5840; margin-bottom:2.5rem; }
 .collection-nav a { flex:1 1 150px; display:flex; align-items:center; justify-content:center; gap:1rem; padding:1rem; color:#e0ccb0; text-decoration:none; }
 .collection-nav a:hover { background:#d7b78012; }
 .collection-nav small { color:#92a090; font-size:.85rem; }
 .shelf-gallery { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2.3rem; align-items:start; }
 .archive-cabinet { scroll-margin-top:calc(var(--ui-header-height) + 1.5rem); padding:0 1rem; border:1px solid #97744270; border-left:9px solid #34271d; border-right:9px solid #34271d; background:linear-gradient(90deg,#100f0c,#282219 48%,#13120d); box-shadow:0 22px 40px #0004,inset 0 0 25px #0008; --cover:#60502e; --cover-light:#806b3e; }
 .archive-cabinet.jade { --cover:#334d3f; --cover-light:#56705a; }
 .archive-cabinet.indigo { --cover:#34434d; --cover-light:#526877; }
 .archive-cabinet.red { --cover:#60362c; --cover-light:#7b4c3a; }
 .cabinet-heading { display:flex; align-items:center; gap:.85rem; min-height:108px; padding:1.2rem .25rem; border-bottom:5px solid #4b3826; }
 .cabinet-number { padding:.25rem .55rem; border:1px solid #a4865266; color:#b99b66; font-size:1.35rem; }
 .cabinet-heading h3 { margin:0 0 .3rem; font-size:1.55rem; letter-spacing:.15em; color:#eedab6; font-weight:500; }
 .cabinet-heading p { margin:0; color:#b5a58b; font-size:.8rem; }
 .volume-count { margin-left:auto; white-space:nowrap; color:#a89170; font-size:.8rem; }
 .shelf-books { display:grid; grid-template-columns:repeat(auto-fill,minmax(65px,1fr)); padding:0 .25rem; background:repeating-linear-gradient(to bottom,transparent 0 196px,#473221 196px 208px); }
 .book-slot { display:flex; align-items:end; justify-content:center; height:208px; padding:18px 6px 12px; border-bottom:12px solid #473221; box-shadow:0 6px 5px #0006; }
 .ancient-book { position:relative; display:block; width:48px; height:var(--volume-height); color:#27251d; text-decoration:none; touch-action:manipulation; }
 /* The link stays flat; only its non-interactive cover moves, preserving Edge hit testing. */
