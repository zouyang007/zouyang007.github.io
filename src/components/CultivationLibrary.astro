---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
const names: Record<string, {name: string; note: string; tone: string}> = {
 '历史上的今天': { name: '大陆纪要', note: '朝代兴替，岁月留痕', tone: 'ochre' },
 '每日新闻早报': { name: '万界见闻', note: '四海风物，人间新事', tone: 'jade' },
 'AI新闻速递': { name: '天机秘录', note: '推演万象，窥见未来', tone: 'indigo' },
 'GitHub高分项目': { name: '百工造物', note: '奇巧之术，开源之器', tone: 'red' },
 '每周总结': { name: '万界周志', note: '拾遗录事，收纳新知', tone: 'ochre' },
};
const categories = [...new Set(posts.map(post => post.data.category))];
const ordered = [...Object.keys(names).filter(category => categories.includes(category)), ...categories.filter(category => !names[category])];
const shelves = ordered.map((category, index) => ({
 category, id: `collection-${index + 1}`, ...(names[category] ?? {name: `${category}阁`, note: '拾遗录事，收纳新知', tone: 'ochre'}),
 posts: posts.filter(post => post.data.category === category),
}));
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {year:'numeric',month:'2-digit',day:'2-digit'}).format(date);
---

<div class="cultivation-library" data-cultivation-library>
 <section class="pavilion" data-pavilion aria-labelledby="pavilion-title">
  <img class="pavilion-art" src="/images/immortal-library.webp" width="1536" height="1024" alt="云山之间的三层藏书阁，飞檐下灯火温暖，中央石阶通向木制大门" fetchpriority="high" />
  <div class="pavilion-shade" aria-hidden="true"></div>
  <div class="pavilion-heading"><p>未名手记 · 山中一阁</p><h1 id="pavilion-title">藏书阁</h1><span>收天下见闻 · 藏万卷新知</span></div>
  <a class="pavilion-door" href="#shelves" data-enter-library aria-label="推门入阁，浏览分类书架"><span>推门入阁</span><small>叩门 · 阅卷</small></a>
  <div class="pavilion-caption"><span>{shelves.length} 座书架 · {posts.length} 卷藏书</span><p>择一卷书，入一方天地。</p><a href="/posts/">直接浏览全部文章 →</a></div>
 </section>

 <section class="library-interior" id="shelves" data-library-interior aria-labelledby="interior-title">
  <header class="interior-heading"><div><p class="eyebrow">云深处 · 藏书阁</p><h2 id="interior-title" tabindex="-1">万卷入阁</h2><p>依门类寻书，轻触书脊即可展卷。</p></div><a href="#" data-leave-library class="quiet-button">返回阁前</a></header>
  <nav class="collection-nav" aria-label="藏书分类">{shelves.map((shelf, shelfIndex) => <a href={`#${shelf.id}`} data-shelf-tab data-shelf-index={shelfIndex} aria-current={shelfIndex === 0 ? 'true' : undefined}><span>{shelf.name}</span><small>{shelf.posts.length} 卷</small></a>)}</nav>
  <div class="shelf-carousel" data-shelf-carousel aria-label="分类书架轮播" tabindex="0">
   <button class="shelf-arrow shelf-arrow-prev" type="button" data-shelf-prev disabled={shelves.length < 2} aria-label={`上一阁：${shelves.at(-1)?.name ?? ''}`}><b aria-hidden="true">‹</b></button>
   <div class="shelf-stage">
    <div class="shelf-gallery">{shelves.map((shelf, shelfIndex) => (
   <section class:list={['archive-cabinet', shelf.tone, shelfIndex === 0 && 'is-active-shelf']} id={shelf.id} aria-labelledby={`${shelf.id}-title`} data-category-shelf data-category={shelf.category} data-shelf-index={shelfIndex} data-shelf-name={shelf.name} hidden={shelfIndex !== 0}>
    <header class="cabinet-heading"><div><h3 id={`${shelf.id}-title`}>{shelf.name}</h3><p>{shelf.category} · {shelf.note}</p></div><span class="volume-count">{shelf.posts.length} 卷</span></header>
    <div class="shelf-books"><span class="shelf-rails" aria-hidden="true"></span>{shelf.posts.map((post, index) => (
     <div class="book-slot">
      <a class="ancient-book" href={`/posts/${post.id}/`} data-library-book data-title={post.data.title} data-description={post.data.description} data-category={post.data.category} data-collection={shelf.name} data-keywords={post.data.tags.join(' · ') || post.data.category} data-date={formatDate(post.data.pubDate)} aria-label={`展卷：${post.data.title}`} aria-describedby="book-keyword-tooltip" style={`--volume-height:${146 + (index % 4) * 8}px;--lean:${(index % 3 - 1) * 1.5}deg;--book-order:${index}`}>
       <span class="volume-visual"><span class="thread-binding" aria-hidden="true">┄<br/>┄<br/>┄</span><span class="volume-label">{post.data.title.slice(0, 16)}{post.data.title.length > 16 ? '…' : ''}</span><span class="volume-index">{String(index + 1).padStart(2, '0')}</span></span>
      </a>
     </div>
    ))}</div>
   <footer class="cabinet-footer"><span>{shelf.name} · 藏</span><a href={`/categories/${encodeURIComponent(shelf.category)}/`}>查看本门全部文章 →</a></footer>
   </section>
    ))}</div>
   </div>
   <button class="shelf-arrow shelf-arrow-next" type="button" data-shelf-next disabled={shelves.length < 2} aria-label={`下一阁：${shelves[1]?.name ?? shelves[0]?.name ?? ''}`}><b aria-hidden="true">›</b></button>
  </div>
  <p class="sr-only" aria-live="polite" data-shelf-announcer></p>
 {posts.length === 0 && <p class="empty-library">阁中暂未收录典籍，待来日添卷。</p>}
 </section>

 <div class="keyword-tooltip" id="book-keyword-tooltip" data-book-tooltip role="tooltip" hidden><strong data-tooltip-title></strong><span data-tooltip-category></span><p data-tooltip-keywords></p></div>
 <dialog class="scroll-dialog" data-book-presentation aria-labelledby="scroll-title">
  <button type="button" data-close-presentation class="close-scroll" aria-label="合上书卷">×</button>
  <p class="eyebrow" data-presented-collection></p><span class="scroll-seal" aria-hidden="true">藏</span>
  <h2 id="scroll-title" data-presented-title></h2>
  <p class="scroll-meta"><span data-presented-category></span><span data-presented-date></span></p>
  <div class="scroll-rule" aria-hidden="true"></div><p class="scroll-description" data-presented-description></p>
  <a class="read-scroll" data-read-article href="/posts/">展开全文 <span aria-hidden="true">→</span></a>
 </dialog>
</div>

<script>
 const root = document.querySelector<HTMLElement>('[data-cultivation-library]');
 if (root) {
  const pavilion = root.querySelector<HTMLElement>('[data-pavilion]')!;
  const interior = root.querySelector<HTMLElement>('[data-library-interior]')!;
  const entrance = root.querySelector<HTMLAnchorElement>('[data-enter-library]')!;
  const dialog = root.querySelector<HTMLDialogElement>('[data-book-presentation]')!;
  const tooltip = root.querySelector<HTMLElement>('[data-book-tooltip]')!;
  const carousel = root.querySelector<HTMLElement>('[data-shelf-carousel]');
  const categoryShelves = Array.from(root.querySelectorAll<HTMLElement>('[data-category-shelf]'));
  const shelfTabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-shelf-tab]'));
  const previousShelfButton = root.querySelector<HTMLButtonElement>('[data-shelf-prev]');
  const nextShelfButton = root.querySelector<HTMLButtonElement>('[data-shelf-next]');
  const shelfAnnouncer = root.querySelector<HTMLElement>('[data-shelf-announcer]');
  let activeShelfIndex = 0;
  let shelfAnimationTimer = 0;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const activateShelf = (requestedIndex: number, direction: 'previous' | 'next' | 'none' = 'none', updateHash = false, announce = true) => {
   if (!categoryShelves.length) return;
   const total = categoryShelves.length;
   const nextIndex = (requestedIndex + total) % total;
   const previousIndex = (nextIndex - 1 + total) % total;
   const followingIndex = (nextIndex + 1) % total;
   window.clearTimeout(shelfAnimationTimer);
   categoryShelves.forEach((shelf, index) => {
    const active = index === nextIndex;
    shelf.hidden = !active;
    shelf.classList.toggle('is-active-shelf', active);
    shelf.classList.remove('is-switching-previous', 'is-switching-next');
   });
   const activeShelf = categoryShelves[nextIndex];
   if (direction !== 'none') {
    void activeShelf.offsetWidth;
    activeShelf.classList.add(direction === 'next' ? 'is-switching-next' : 'is-switching-previous');
    shelfAnimationTimer = window.setTimeout(() => activeShelf.classList.remove('is-switching-previous', 'is-switching-next'), reducedMotion ? 0 : 440);
   }
   shelfTabs.forEach((tab, index) => {
    if (index === nextIndex) tab.setAttribute('aria-current', 'true');
    else tab.removeAttribute('aria-current');
   });
   const currentName = activeShelf.dataset.shelfName ?? '';
   const previousName = categoryShelves[previousIndex].dataset.shelfName ?? '';
   const followingName = categoryShelves[followingIndex].dataset.shelfName ?? '';
   previousShelfButton?.setAttribute('aria-label', `上一阁：${previousName}`);
   nextShelfButton?.setAttribute('aria-label', `下一阁：${followingName}`);
   activeShelfIndex = nextIndex;
   if (updateHash) history.replaceState(null, '', `#${activeShelf.id}`);
   if (announce && shelfAnnouncer) shelfAnnouncer.textContent = `当前书架：${currentName}，第 ${nextIndex + 1} 座，共 ${total} 座`;
  };
  const syncRoom = () => {
   const inside = location.hash === '#shelves' || location.hash.startsWith('#collection-');
   pavilion.hidden = inside; interior.hidden = !inside;
   if (inside && location.hash.startsWith('#collection-')) {
    const shelfIndex = categoryShelves.findIndex(shelf => `#${shelf.id}` === location.hash);
    if (shelfIndex >= 0) activateShelf(shelfIndex, 'none', false, false);
   }
  };
  const initialShelfIndex = categoryShelves.findIndex(shelf => `#${shelf.id}` === location.hash);
  activateShelf(initialShelfIndex >= 0 ? initialShelfIndex : 0, 'none', false, false);
  syncRoom();
  window.addEventListener('hashchange', syncRoom);
  previousShelfButton?.addEventListener('click', () => activateShelf(activeShelfIndex - 1, 'previous', true));
  nextShelfButton?.addEventListener('click', () => activateShelf(activeShelfIndex + 1, 'next', true));
  shelfTabs.forEach((tab, index) => tab.addEventListener('click', event => {
   event.preventDefault();
   const direction = index >= activeShelfIndex ? 'next' : 'previous';
   activateShelf(index, direction, true);
   carousel?.scrollIntoView({block:'start',behavior:reducedMotion ? 'instant' : 'smooth'});
  }));
  carousel?.addEventListener('keydown', event => {
   if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
   event.preventDefault();
   activateShelf(activeShelfIndex + (event.key === 'ArrowRight' ? 1 : -1), event.key === 'ArrowRight' ? 'next' : 'previous', true);
  });
  entrance.addEventListener('click', (event) => {
   event.preventDefault();
   activateShelf(0, 'none', false, false);
   location.hash = 'shelves';
   syncRoom();
   window.scrollTo({top:0,behavior:'instant'});
   interior.querySelector<HTMLElement>('h2')?.focus({preventScroll:true});
  });
 root.querySelector('[data-leave-library]')?.addEventListener('click', () => {
  tooltip.hidden = true;
   window.setTimeout(() => { entrance.focus({preventScroll:true}); window.scrollTo({top:0,behavior:'instant'}); }, 0);
  });
  const positionTooltip = (x: number, y: number) => {
   const bounds = tooltip.getBoundingClientRect();
   tooltip.style.left = `${Math.max(10, Math.min(x + 14, innerWidth - bounds.width - 10))}px`;
   tooltip.style.top = `${Math.max(10, Math.min(y + 18, innerHeight - bounds.height - 10))}px`;
  };
  for (const book of root.querySelectorAll<HTMLAnchorElement>('[data-library-book]')) {
   const show = (x?: number, y?: number) => {
    tooltip.querySelector('[data-tooltip-title]')!.textContent = book.dataset.title ?? '';
    tooltip.querySelector('[data-tooltip-category]')!.textContent = `${book.dataset.collection} · ${book.dataset.category}`;
    tooltip.querySelector('[data-tooltip-keywords]')!.textContent = `关键词 · ${book.dataset.keywords}`;
    tooltip.hidden = false; const box = book.getBoundingClientRect(); positionTooltip(x ?? box.right, y ?? box.top);
   };
   book.addEventListener('pointerenter', e => {if (e.pointerType !== 'touch') show(e.clientX, e.clientY);});
   book.addEventListener('pointermove', e => { if (e.pointerType !== 'touch' && !dialog.open) show(e.clientX, e.clientY); });
   book.addEventListener('pointerleave', () => tooltip.hidden = true);
   book.addEventListener('focus', () => show());
   book.addEventListener('blur', () => tooltip.hidden = true);
   book.addEventListener('click', e => {
    if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
    e.preventDefault(); tooltip.hidden = true;
    for (const field of ['title','description','category','date','collection']) {
     dialog.querySelector(`[data-presented-${field}]`)!.textContent = book.dataset[field] ?? '';
    }
    dialog.querySelector<HTMLAnchorElement>('[data-read-article]')!.href = book.href;
    dialog.showModal();
   });
  }
  root.querySelector('[data-close-presentation]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', e => { if(e.target === dialog) { const r=dialog.getBoundingClientRect(); if(e.clientX<r.left || e.clientX>r.right || e.clientY<r.top || e.clientY>r.bottom) dialog.close(); } });
  dialog.addEventListener('close', () => tooltip.hidden = true);
  window.addEventListener('scroll', () => tooltip.hidden = true, {passive:true});
  window.addEventListener('resize', () => tooltip.hidden = true);
  window.addEventListener('pagehide', () => {
   window.clearTimeout(shelfAnimationTimer);
  });
 }
</script>

<style>
 .cultivation-library { --gold:#d7b780; --jade:#91a995; --text:#efe7d5; color:var(--text); font-family:var(--font-serif); }
 [hidden] { display:none !important; }
 .pavilion { position:relative; height:calc(100svh - var(--ui-header-height)); min-height:650px; overflow:hidden; background:#142320; --image-height:max(66.6667vw, calc(100svh - var(--ui-header-height)), 650px); }
 .pavilion-art { width:100%; height:100%; object-fit:cover; object-position:center; border-radius:0; }
 .pavilion-shade { position:absolute; inset:0; pointer-events:none; background:linear-gradient(180deg,rgba(6,17,17,.52),transparent 28%,transparent 68%,rgba(5,15,14,.92)); }
 .pavilion-heading { position:absolute; top:3%; left:50%; transform:translateX(-50%); text-align:center; width:90%; text-shadow:0 3px 18px #071512; pointer-events:none; }
 .pavilion-heading p { margin:0 0 .4rem; font-size:.85rem; letter-spacing:.38em; color:#e7d6b5; }
 .pavilion-heading h1 { margin:0; font-size:clamp(2.6rem,5.5vw,4.8rem); letter-spacing:.3em; padding-left:.3em; font-weight:500; color:#f4e8ce; }
 .pavilion-heading > span { display:block; margin-top:.7rem; color:#d2d8cc; font-size:.85rem; letter-spacing:.2em; }
 .pavilion-door { position:absolute; left:50%; top:calc(50% + var(--image-height) * .129); transform:translate(-50%,-50%); width:calc(var(--image-height) * .15); min-width:110px; height:calc(var(--image-height) * .15); min-height:100px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.4rem; border:1px solid rgba(231,189,107,.45); border-radius:3px; color:#ffedc1; text-decoration:none; background:rgba(26,16,5,.12); box-shadow:inset 0 0 20px #efb55228,0 0 24px #e8c77322; transition:background .25s,box-shadow .25s; }
 .pavilion-door span { padding:.5rem .65rem; background:#1e160dbb; border:1px solid #b8955d80; letter-spacing:.18em; font-size:1rem; }
 .pavilion-door small { font-size:.75rem; text-shadow:0 2px 5px #000; }
 .pavilion-door:hover,.pavilion-door:focus-visible { color:#fff2ce; background:#f2bd5530; box-shadow:inset 0 0 35px #f3c36d55,0 0 42px #e6b64e55; outline:2px solid var(--gold); outline-offset:5px; }
 .pavilion-caption { position:absolute; left:0; right:0; bottom:3%; text-align:center; }
 .pavilion-caption > span { color:#b9c8bb; font-size:.85rem; letter-spacing:.18em; }
 .pavilion-caption p { margin:.45rem 0; color:#f1e0bf; font-size:1.1rem; letter-spacing:.1em; }
 .pavilion-caption a { color:#bac5b7; font-size:.85rem; text-underline-offset:5px; }
 .library-interior { position:relative; isolation:isolate; min-height:calc(100svh - var(--ui-header-height)); max-width:1400px; margin:auto; padding:3rem 2rem 5rem; }
 .library-interior::before { content:''; position:absolute; z-index:-3; left:50%; top:0; bottom:0; width:100vw; transform:translateX(-50%); border-top:1px solid #8f74434d; border-bottom:1px solid #8f744338; background-color:#0b120f; background-image:linear-gradient(90deg,#04100bbd 0,transparent 18%,transparent 82%,#04100bbd 100%),linear-gradient(180deg,#07100dd6 0,transparent 19%,transparent 74%,#07100de3 100%),url('/images/library/archive-hall-bg-v1.png'); background-position:center,center,center center; background-size:auto,auto,cover; background-repeat:no-repeat; box-shadow:inset 0 20px 55px #0008,inset 0 -50px 80px #000a; }
 .library-interior::after { content:''; position:absolute; z-index:-2; left:50%; top:0; bottom:0; width:100vw; transform:translateX(-50%); pointer-events:none; background:radial-gradient(ellipse at center 47%,transparent 0 32%,#06100b24 63%,#020604a3 100%),linear-gradient(180deg,transparent 70%,#c4a15e0a 84%,transparent 100%); }
 .interior-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; max-width:1040px; margin:0 auto 1.25rem; padding:1rem 1.25rem; border:1px solid #a8874f47; background:#07100cca; box-shadow:inset 0 0 20px #0008,0 12px 26px #0005; backdrop-filter:blur(5px); }
 .eyebrow { margin:0 0 .65rem; color:var(--gold); font-size:.85rem; letter-spacing:.25em; }
 .interior-heading h2 { margin:0 0 .75rem; font-size:clamp(2.3rem,5vw,3.8rem); color:var(--text); font-weight:500; letter-spacing:.15em; }
 .interior-heading div > p:last-child { color:#a6b4a8; margin:0; font-size:1rem; }
 .quiet-button { padding:.6rem 1rem; border:1px solid #a98d584d; color:#d5bd90; text-decoration:none; white-space:nowrap; font-size:.9rem; }
 .collection-nav { display:flex; flex-wrap:wrap; max-width:1040px; margin:0 auto 2.5rem; border:3px ridge #4b3521; background-color:#130e09dc; background-image:linear-gradient(180deg,#8c642a18,#0008),url('/images/library/archive-walnut-v1.png'); background-size:auto,390px auto; box-shadow:inset 0 2px #be955938,0 14px 30px #0007; backdrop-filter:blur(4px); }
 .collection-nav a { flex:1 1 150px; display:flex; align-items:center; justify-content:center; gap:1rem; padding:1rem; color:#e0ccb0; text-decoration:none; }
 .collection-nav a:hover { background:#d7b78012; }
 .collection-nav a[aria-current='true'] { color:#f2ddb5; background:#d7b78016; box-shadow:inset 0 -2px #c5a367; }
 .collection-nav small { color:#92a090; font-size:.85rem; }
 .shelf-carousel { position:relative; isolation:isolate; display:grid; grid-template-columns:48px minmax(0,900px) 48px; align-items:center; justify-content:center; gap:clamp(.45rem,1.2vw,1rem); scroll-margin-top:calc(var(--ui-header-height) + 1rem); }
 .shelf-stage { position:relative; z-index:2; min-width:0; }
 .shelf-arrow { position:relative; z-index:3; display:flex; align-items:center; justify-content:center; width:44px; height:54px; padding:0; border:1px solid #c6a66942; border-radius:999px; color:#ccb68d; background:#0b15113b; box-shadow:inset 0 0 10px #d4b2700a,0 7px 18px #0003; backdrop-filter:blur(3px); opacity:.7; cursor:pointer; transition:transform 180ms ease,opacity 180ms ease,background 180ms ease,border-color 180ms ease; }
 .shelf-arrow b { color:#e2c58f; font-family:serif; font-size:2.15rem; font-weight:400; line-height:.8; transform:translateY(-1px); }
 .shelf-arrow:hover,.shelf-arrow:focus-visible { border-color:#d7b7809e; background:#18231d82; opacity:1; outline:2px solid #d7b78080; outline-offset:3px; }
 .shelf-arrow-prev:hover { transform:translateX(-4px); }
 .shelf-arrow-next:hover { transform:translateX(4px); }
 .shelf-arrow:disabled { opacity:.35; cursor:not-allowed; transform:none; }
 .shelf-gallery { display:block; min-width:0; }
 .archive-cabinet.is-switching-next { animation:shelf-from-right 420ms cubic-bezier(.2,.72,.2,1) both; }
 .archive-cabinet.is-switching-previous { animation:shelf-from-left 420ms cubic-bezier(.2,.72,.2,1) both; }
 .archive-cabinet { position:relative; isolation:isolate; display:flex; flex-direction:column; width:100%; scroll-margin-top:calc(var(--ui-header-height) + 1.5rem); padding:10px 1.15rem 8px; border:clamp(7px,.65vw,11px) ridge #3b2819; background-color:#1a130d; background-image:linear-gradient(90deg,#080604d6,transparent 18% 77%,#070503d9),linear-gradient(180deg,#0006,transparent 23% 74%,#0009),url('/images/library/archive-walnut-v1.png'); background-size:auto,auto,420px auto; box-shadow:0 28px 46px #0008,0 6px 0 #0b0705,inset 3px 0 #c0935730,inset -4px 0 #000a,inset 0 0 34px #000b; --cover:#60502e; --cover-light:#806b3e; }
 .archive-cabinet::before,.archive-cabinet::after { content:''; position:absolute; z-index:5; left:-18px; right:-18px; pointer-events:none; background-image:linear-gradient(180deg,#9b713324,#000a),url('/images/library/archive-walnut-v1.png'); background-size:auto,360px auto; border:3px ridge #28180f; box-shadow:inset 0 2px #bd915435,0 8px 14px #000a; }
 .archive-cabinet::before { top:-19px; height:24px; clip-path:polygon(2% 0,98% 0,100% 100%,0 100%); transform:perspective(300px) rotateX(-18deg); transform-origin:bottom; }
 .archive-cabinet::after { bottom:-24px; height:30px; clip-path:polygon(0 0,100% 0,97.5% 100%,2.5% 100%); transform:perspective(300px) rotateX(18deg); transform-origin:top; filter:brightness(.74); }
 .archive-cabinet.jade { --cover:#334d3f; --cover-light:#56705a; }
 .archive-cabinet.indigo { --cover:#34434d; --cover-light:#526877; }
 .archive-cabinet.red { --cover:#60362c; --cover-light:#7b4c3a; }
 .cabinet-heading { position:relative; z-index:3; display:flex; align-items:center; gap:.85rem; min-height:104px; padding:1.2rem 1.35rem; border:5px ridge #4a321f; border-bottom-width:13px; background-image:linear-gradient(90deg,#0008,transparent 22% 78%,#0009),linear-gradient(180deg,#81592d18,#0008),url('/images/library/archive-walnut-v1.png'); background-size:auto,auto,390px auto; background-position:center; box-shadow:inset 0 2px #b88c5230,inset 0 -12px 18px #0009,0 9px 14px #0008; }
