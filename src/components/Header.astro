---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header data-pagefind-ignore>
	<nav aria-label="主导航">
		<a class="brand" href="/" aria-label={`${SITE_TITLE}首页`}>
			<span class="brand-mark" aria-hidden="true">未</span>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/posts">文章</HeaderLink>
			<HeaderLink href="/archive">归档</HeaderLink>
			<HeaderLink href="/search">搜索</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<ThemeToggle />
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper) 92%, transparent);
		backdrop-filter: blur(14px);
	}
	nav {
		width: min(1120px, calc(100% - 2rem));
		min-height: var(--ui-header-height);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--ink);
		font-family: var(--font-serif);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
	}
	.brand-mark {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border-radius: 50%;
		background: var(--accent);
		color: white;
		font-size: 0.9rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	:global(.internal-links > a) { white-space: nowrap; }
	@media (max-width: 720px) {
		nav {
			min-height: auto;
			padding: 0.75rem 0;
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
		}
		.internal-links {
			width: 100%;
			overflow-x: auto;
		}
	}
</style>
