---
import { libraryNames } from '../utils/library';
interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const { eyebrow, title, description } = Astro.props;
const chapterNames: Record<string,string> = {Search:'阁中寻卷',Archive:'岁月卷宗',About:'阁主小记',Category:'分阁藏书',Categories:'藏书门类',Tag:'卷中索引',Tags:'万卷书签'};
---

<header class="page-intro">
	<p>{chapterNames[eyebrow] ?? eyebrow}</p>
	<h1>{libraryNames[title] ?? title}</h1>
	<div>{libraryNames[title] ? `${title} · ` : ''}{description}</div>
</header>

<style>
	.page-intro { max-width: 760px; margin-bottom: 3rem; }
	p { margin: 0 0 0.9rem; color: var(--accent); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; }
	h1 { margin: 0 0 1rem; letter-spacing: -0.045em; }
	div { max-width: 620px; color: var(--muted); font-size: 1.05rem; }
</style>
