---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
const today = new Date();
---

<footer data-pagefind-ignore>
	<div class="footer-inner">
		<div>
			<strong>{SITE_TITLE}</strong>
			<p>用文字保存值得反复阅读的事。</p>
		</div>
		<div class="footer-links">
			<a href="/rss.xml">RSS</a>
			<a href="/about">关于</a>
		</div>
		<small>© {today.getFullYear()} {SITE_AUTHOR}</small>
	</div>
</footer>

<style>
	footer {
		margin-top: 5rem;
		padding: 3rem 1rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
	}
	.footer-inner {
		width: min(1120px, 100%);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: end;
		gap: 2rem;
	}
	strong { color: var(--ink); font-family: var(--font-serif); }
	p { margin: 0.35rem 0 0; font-size: 0.88rem; }
	.footer-links { display: flex; gap: 1rem; }
	.footer-links a { color: inherit; text-decoration: none; }
	.footer-links a:hover { color: var(--accent); }
	small { white-space: nowrap; }
	@media (max-width: 720px) {
		.footer-inner { grid-template-columns: 1fr; align-items: start; gap: 1rem; }
	}
</style>
