---
import PageIntro from '../components/PageIntro.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_TITLE } from '../consts';
---

<PageLayout title={`全文搜索 · ${SITE_TITLE}`} description="搜索全部已发布文章的标题与正文。">
	<PageIntro eyebrow="Search" title="全文搜索" description="输入标题、主题或正文中的中文关键词。搜索在浏览器本地完成，不会上传查询内容。" />
	<div id="search"><pagefind-searchbox></pagefind-searchbox></div>
	<noscript>请启用 JavaScript 后使用全文搜索。</noscript>
</PageLayout>

<link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>

<style>
	#search { min-height: 260px; }
	#search { --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--paper); --pagefind-ui-border: var(--line); --pagefind-ui-border-width: 1px; --pagefind-ui-border-radius: 6px; --pagefind-ui-font: var(--font-sans); }
	pagefind-searchbox { display: block; width: 100%; }
</style>
