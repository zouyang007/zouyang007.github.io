---
import PageIntro from '../../components/PageIntro.astro';
import TermCloud from '../../components/TermCloud.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts, getTags } from '../../utils/posts';

const posts = await getPublishedPosts();
const items = getTags(posts).map((name) => ({ name, count: posts.filter((post) => post.data.tags.includes(name)).length }));
---

<PageLayout title={`文章标签 · ${SITE_TITLE}`} description="按照关键词浏览博客文章。">
	<PageIntro eyebrow="Tags" title="文章标签" description="标签连接跨越不同分类、但彼此相关的文章。" />
	<TermCloud items={items} basePath="/tags" />
</PageLayout>
