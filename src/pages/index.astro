---
import BaseHead from '../components/BaseHead.astro';
import CategoryDock from '../components/CategoryDock.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import CultivationLibrary from '../components/CultivationLibrary.astro';
import UiCustomizer from '../components/UiCustomizer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="zh-CN" data-site-skin="cultivation" data-theme="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<CategoryDock />
		<UiCustomizer />
		<main class="home-shell">
			<CultivationLibrary posts={posts} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell { width: 100%; padding: 0; }
</style>
