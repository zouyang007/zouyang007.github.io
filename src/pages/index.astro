---
import BaseHead from '../components/BaseHead.astro';
import CategoryDock from '../components/CategoryDock.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_INTRO, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = (await getPublishedPosts()).slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<CategoryDock />
		<main class="home-shell">
			<section class="hero">
				<p class="eyebrow">个人博客 · 持续写作</p>
				<h1>{SITE_INTRO}</h1>
				<p class="lead">{SITE_DESCRIPTION} 不追逐喧闹，只留下经得起时间的内容。</p>
				<div class="hero-actions">
					<a class="button" href="/posts">开始阅读</a>
					<a class="text-link" href="/about">认识作者 <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="latest">
				<div class="section-heading">
					<div><p class="eyebrow">Latest notes</p><h2>最近写作</h2></div>
					<a href="/posts">查看全部</a>
				</div>
				<div class="post-grid">
					{posts.map((post, index) => (
						<article class="post-card">
							<p class="post-number">{String(index + 1).padStart(2, '0')}</p>
							<div>
								<p class="post-meta"><FormattedDate date={post.data.pubDate} /></p>
								<h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
								<p>{post.data.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell { width: min(1120px, calc(100% - 2rem)); }
	.hero { padding: clamp(5rem, 11vw, 9rem) 0 clamp(4rem, 8vw, 7rem); max-width: 900px; }
	.eyebrow { margin: 0 0 1rem; color: var(--accent); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
	.hero h1 { max-width: 13ch; margin: 0; font-size: clamp(2.7rem, 7vw, 5.8rem); line-height: 1.04; letter-spacing: -0.055em; }
	.lead { max-width: 630px; margin: 1.8rem 0 0; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.25rem); }
	.hero-actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2.4rem; }
	.button { padding: 0.82rem 1.25rem; border-radius: 999px; background: var(--ink); color: var(--paper); text-decoration: none; font-weight: 700; }
	.button:hover { background: var(--accent); color: white; }
	.text-link { color: var(--ink); font-weight: 700; text-decoration-thickness: 1px; text-underline-offset: 0.3em; }
	.latest { padding: 3rem 0 1rem; border-top: 1px solid var(--line); }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
	.section-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); }
	.section-heading > a { color: var(--muted); font-size: 0.9rem; }
	.post-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
	.post-card { min-height: 280px; padding: 1.5rem; border-right: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; gap: 3rem; }
	.post-card:last-child { border-right: 0; }
	.post-number, .post-meta { margin: 0; color: var(--muted); font-size: 0.75rem; letter-spacing: 0.08em; }
	.post-card h3 { margin: 0.65rem 0 0.75rem; font-size: 1.45rem; }
	.post-card h3 a { color: var(--ink); text-decoration: none; }
	.post-card h3 a:hover { color: var(--accent); }
	.post-card div > p:last-child { margin: 0; color: var(--muted); font-size: 0.92rem; line-height: 1.65; }
	@media (max-width: 760px) {
		.hero { padding-top: 4rem; }
		.post-grid { grid-template-columns: 1fr; }
		.post-card { min-height: auto; border-right: 0; border-bottom: 1px solid var(--line); }
		.hero-actions { align-items: flex-start; flex-direction: column; gap: 1rem; }
	}
</style>
