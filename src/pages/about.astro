---
import PageIntro from '../components/PageIntro.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<PageLayout title={`关于 · ${SITE_TITLE}`} description={`关于${SITE_AUTHOR}与这个博客。`}>
	<PageIntro eyebrow="About" title="关于这里" description={SITE_DESCRIPTION} />
	<div class="about-copy">
		<p>你好，我是<strong>{SITE_AUTHOR}</strong>。这里记录技术、阅读与日常思考，也保存那些值得反复回看的经验。</p>
		<p>这个博客用来记录技术实践、阅读笔记，以及那些值得慢下来想一想的问题。文章不追求数量，希望每一篇都能在未来继续被修订和引用。</p>
		<h2>联系与转载</h2>
		<p>请在这里补充你的 GitHub 主页或公开邮箱。除非单篇文章另有说明，转载前请先联系作者并保留原文链接。</p>
		<h2>关于本站</h2>
		<p>本站使用 Astro 构建，托管于 GitHub Pages。全文搜索在浏览器本地运行，不设置评论、访问统计或广告脚本。</p>
	</div>
</PageLayout>

<style>
	.about-copy { font-family: var(--font-serif); font-size: 1.08rem; line-height: 1.95; }
	h2 { margin-top: 2.5rem; }
</style>
